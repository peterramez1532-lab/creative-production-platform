generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  ADMIN
  MANAGER
  CLIENT
  TALENT
}
enum ProjectStatus {
  DRAFT
  AWAITING_PROPOSAL
  PROPOSAL_SENT
  APPROVED
  PLANNING
  IN_PRODUCTION
  INTERNAL_QA
  CLIENT_REVIEW
  REVISION
  READY_FOR_DELIVERY
  DELIVERED
  ON_HOLD
  CANCELLED
}
enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  QA
  REVISION
  APPROVED
  DELIVERED
}
enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role Role @default(TALENT)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id])
  talent TalentProfile?
  ownedProjects Project[] @relation("ProjectManager")
  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks Task[] @relation("TaskCreator")
  submissions Submission[]
  qaReviews QAReview[]
  notifications Notification[]
  messages Message[]
  auditLogs AuditLog[]
}
model Organization {
  id String @id @default(cuid())
  name String
  industry String?
  createdAt DateTime @default(now())
  users User[]
  projects Project[]
}
model TalentProfile {
  id String @id @default(cuid())
  userId String @unique
  bio String @default("")
  location String @default("Egypt")
  skills String @default("Illustration")
  specialization String @default("Digital Content")
  availability String @default("AVAILABLE")
  yearsExperience Int @default(1)
  hourlyRate Float?
  qualityScore Float?
  reliabilityScore Float?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
model Project {
  id String @id @default(cuid())
  code String @unique
  title String
  type String @default("Digital Content")
  brief String
  status ProjectStatus @default(DRAFT)
  priority Priority @default(NORMAL)
  deadline DateTime?
  startDate DateTime?
  clientPrice Float?
  internalCost Float?
  currency String @default("USD")
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id])
  managerId String?
  manager User? @relation("ProjectManager", fields: [managerId], references: [id])
  tasks Task[]
  milestones Milestone[]
  messages Message[]
  submissions Submission[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, deadline])
  @@index([organizationId])
}
model Task {
  id String @id @default(cuid())
  code String @unique
  title String
  description String @default("")
  type String @default("Production")
  requiredSkill String @default("")
  status TaskStatus @default(PENDING)
  priority Priority @default(NORMAL)
  dueDate DateTime?
  estimatedHours Float @default(4)
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assigneeId String?
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId String
  creator User @relation("TaskCreator", fields: [creatorId], references: [id])
  submissions Submission[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, dueDate])
  @@index([assigneeId])
}
model Milestone {
  id String @id @default(cuid())
  title String
  dueDate DateTime?
  completed Boolean @default(false)
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
model Submission {
  id String @id @default(cuid())
  version Int @default(1)
  fileName String
  storageName String
  mimeType String
  size Int
  note String @default("")
  status String @default("SUBMITTED")
  taskId String?
  task Task? @relation(fields: [taskId], references: [id])
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader User @relation(fields: [uploaderId], references: [id])
  reviews QAReview[]
  createdAt DateTime @default(now())
  @@index([taskId, version])
}
model QAReview {
  id String @id @default(cuid())
  decision String
  score Float?
  feedback String
  reviewerId String
  reviewer User @relation(fields: [reviewerId], references: [id])
  submissionId String
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
model Notification {
  id String @id @default(cuid())
  title String
  body String
  href String?
  readAt DateTime?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, readAt])
}
model Message {
  id String @id @default(cuid())
  body String
  visibility String @default("INTERNAL")
  userId String
  user User @relation(fields: [userId], references: [id])
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
model Invoice {
  id String @id @default(cuid())
  reference String @unique
  projectId String
  clientName String
  currency String @default("USD")
  total Float
  paid Float @default(0)
  dueDate DateTime?
  status String @default("PENDING")
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  action String
  entityType String
  entityId String
  metadata String @default("{}")
  actorId String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([entityType, entityId, createdAt])
}

